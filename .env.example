# ── Darpann CRM – copy to .env and fill in real values. Never commit .env itself. ──
DATABASE_URL="mysql://USER:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/darpan_crm?sslaccept=strict"

JWT_SECRET="change-me"
ACCESS_TOKEN_HOURS=12

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=darpanninvestmentsindia@gmail.com
SMTP_PASSWORD="gmail-app-password"
SMTP_FROM_NAME="Darpann Investments CRM"

APP_URL=http://localhost:3000
UPLOAD_DIR=./uploads

# First super-admin created by the seed script
SEED_ADMIN_EMAIL=darpanninvestmentsindia@gmail.com
SEED_ADMIN_PASSWORD="change-me"

# Security
ENVIRONMENT=development          # production → HTTPS-only cookies, HSTS, API docs hidden
PASSWORD_LOGIN_ENABLED=false     # false = sign in only with one-time email codes
SESSION_IDLE_MINUTES=240
EMAIL_LOGO_URL=https://darpanninvestments.com/wp-content/themes/darpan/assets/images/logo.png
